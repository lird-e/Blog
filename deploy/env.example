# 博客服务端环境变量模板：复制为 /var/blog/.env 后填写真实值，权限设为 600。
# 生成密码哈希：go run ./server/cmd/genpass 你的强密码
# 生成随机密钥：openssl rand -hex 32

# 服务监听地址（只听本机，由 Nginx 反代）
BLOG_ADDR=127.0.0.1:8080

# SQLite 数据库文件路径
BLOG_DB=/var/blog/blog.db

# 管理员账号
ADMIN_USER=admin
ADMIN_PASS_HASH=$2a$10$替换为genpass输出的哈希

# JWT 签名密钥（必须设置，否则管理端禁用）
JWT_SECRET=替换为openssl_rand_hex_32的输出

# 评论 IP/邮箱加盐哈希的盐（随机字符串，泄露会导致匿名关联）
IP_SALT=替换为另一串随机字符串

# 站点对外地址（RSS/sitemap 用）：IP 直连阶段填 http://服务器公网IP，
# 未来绑域名后改成 https://your-domain 并可同时 301
SITE_URL=http://127.0.0.1
SITE_TITLE=我的博客
SITE_DESC=记录技术、思考与生活。
